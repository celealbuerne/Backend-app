  "fechaNacimiento": "1970-05-15",
  "contacto": ["carlosxd@example.com", "+5491112345678"]
}


###ID
@id = 10

### GET ONE
GET http://localhost:3000/api/usuarios/{{id}}

### UPDATE
PATCH http://localhost:3000/api/usuarios/{{id}}
Content-Type: application/json

{
  "nombre": "Hola",
  "pais": "Argentina",
  "contacto": ["yosoyyuri@lol.rer"]
}

### DELETE
DELETE http://localhost:3000/api/usuarios/{{id}}